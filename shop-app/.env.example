# Production: leave both unset. The app calls /api/user and /api/bills on the
# same origin, which nginx rewrites to the user-service and bill_service
# routes. Hard-coding a port here breaks the deployed build.
#
# Local development only: point them at the services you are running.
# VITE_USER_API_URL=http://localhost:8002
# VITE_BILL_API_URL=http://localhost:8001