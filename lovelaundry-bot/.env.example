# Port the bot service listens on
PORT=3001

# Optional shared secret between the frontend and this backend.
# If set, the frontend must send it as the `x-api-key` header.
# CHAT_API_KEY=

# === Our own model (self-hosted, trained on Love Laundry data) ===
# We build our own model with train.py (LoRA fine-tune of an open base model),
# export it to GGUF and serve it via Ollama. Point the bot at that endpoint:
# LLM_PROVIDER=ollama
# LLM_API_KEY=ollama
# LLM_MODEL=lovelaundry
# LLM_BASE_URL=http://<your-model-host>:11434/v1
# Local dev default (Ollama on this machine):
LLM_PROVIDER=ollama
LLM_API_KEY=ollama
LLM_MODEL=lovelaundry
LLM_BASE_URL=http://localhost:11434/v1

# === Live backend data (so the bot can answer real order questions) ===
# Public quotation-service base URL (no auth needed for /tracking).
QUOTATION_SERVICE_URL=https://your-quotation-service.example.com
# bill_service base URL + master key (for loyalty lookups).
BILL_SERVICE_URL=https://your-bill-service.example.com
MASTER_KEY=
